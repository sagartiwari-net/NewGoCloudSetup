!tools/**/extension/images/**/*.jpg
!tools/**/extension/images/**/*.jpeg
!tools/**/extension/images/**/*.webp
panel/update-panel/.env.production
panel/update-panel/.env.local

# runtime
**/*.log
**/*.pid
**/*.env
!**/mysql.env.example

# built binaries (build on Linux server) — keep folders, ignore known binary names
**/panel-api/panel-api
tools/**/main
tools/**/proxy
tools/*-go-proxy/*-go-proxy
tools/*-go-proxy/*-proxy
*.exe
