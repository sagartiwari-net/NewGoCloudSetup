# Optional overrides — MySQL password comes from _secrets/mysql.env via run script.
# Copy to: /www/wwwroot/gt4rents.com/_secrets/ahrefs-bar-api.env
# chmod 600

AHREFS_BAR_ADDR=127.0.0.1:8088
AHREFS_BAR_DEV_AUTH=0
AHREFS_BAR_MOCK_UPSTREAM=0
AHREFS_BAR_REQUIRE_FP=1
AHREFS_BAR_SEED_DEV_ACCOUNTS=0
AHREFS_BAR_VERIFY_RATE=60
AHREFS_BAR_TZ=Asia/Kolkata

# Shared file cache (compact toolbar fields + zstd). Same Hetzner box as cloudtools.
# Disk: 35 GB URLs + 15 GB keywords — NOT in MySQL gt4rents.
AHREFS_BAR_FILE_CACHE=1
AHREFS_BAR_FILE_CACHE_DIR=/var/lib/toolsmandi/ahrefs-cache
AHREFS_BAR_FILE_CACHE_URL_GB=35
AHREFS_BAR_FILE_CACHE_KW_GB=15
AHREFS_BAR_FILE_CACHE_TTL_HOURS=72

# Panel zip stamping (panel-api process env — set in panel unit or mysql.env)
# AHREFS_BAR_PUBLIC_URL=https://barapi.upays.in
# AHREFS_BAR_EXT_DIR=/www/wwwroot/gt4rents.com/ahrefs-bar-api/extension
# AHREFS_BAR_TEMPLATE_DIR=/www/wwwroot/gt4rents.com/ahrefs-bar-api/templates
