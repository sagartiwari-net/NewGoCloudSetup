[Unit]
Description=ToolsMandi Ahrefs Bar API (127.0.0.1:8088)
After=network-online.target mysql.service mysqld.service mariadb.service
Wants=network-online.target

[Service]
Type=simple
# Same as gt4-panel-api: no User=www — must read _secrets/mysql.env (root-only).
WorkingDirectory=/www/wwwroot/gt4rents.com/ahrefs-bar-api
ExecStart=/www/wwwroot/gt4rents.com/ahrefs-bar-api/run-ahrefs-bar-api.sh
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=0
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
