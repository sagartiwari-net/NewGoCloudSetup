[Unit]
Description=Jungle Scout Go Proxy (amzpremiumsoftware.com)
After=network.target mysql.service

[Service]
Type=simple
User=root
WorkingDirectory=/www/wwwroot/amzpremiumsoftware.com/jungle
ExecStartPre=/bin/bash -c 'fuser -k 8787/tcp 2>/dev/null || true; sleep 2'
ExecStart=/www/wwwroot/amzpremiumsoftware.com/jungle/junglescout-go-proxy
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jungle-amzpremium
LimitNOFILE=65536
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
