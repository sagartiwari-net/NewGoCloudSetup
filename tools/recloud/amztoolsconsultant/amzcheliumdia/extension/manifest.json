{
  "update_url": "https://clients2.google.com/service/update2/crx",
  "manifest_version": 3,
  "name": "Amzc Helium10 Extension",
  "short_name": "Amzc Helium10",
  "description": "Amzc Helium10 Extension for product research, keyword insights, and profit analysis on Amazon, Walmart, and TikTok.",
  "version": "8.43.1",
  "version_name": "8.43.1",
  "author": "Helium10 <support@helium10.com>",
  "default_locale": "en",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "128": "icon/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icon/16-off.png",
      "48": "icon/48.png"
    },
    "default_title": "Amzc Helium10 Extension",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.helium-dev.com/*",
        "*://*.helium10-dev.com/*",
        "*://*.helium10.com/*",
        "*://*.helium-staging.com/*",
        "*://*.amztoolsconsultant.com/*",
        "*://__H10_PROXY_HOST__/*"
      ],
      "css": [],
      "js": [
        "api-redirector.js",
        "marketplace-config.js",
        "domain-detector.js",
        "vendor-react.js",
        "vendor-helium.js",
        "vendor-charts.js",
        "vendors.js",
        "vendor-shared-src.js",
        "vendor-i18n.js",
        "helium-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.com.mx/*",
        "*://*.amazon.de/*",
        "*://*.amazon.es/*",
        "*://*.amazon.it/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.nl/*",
        "*://*.amazon.in/*",
        "*://*.amazon.com.au/*",
        "*://*.amazon.co.jp/*",
        "*://*.amazon.com.br/*",
        "*://*.amazon.ae/*",
        "*://*.amazon.sa/*"
      ],
      "css": [],
      "js": [
        "domain-detector.js",
        "vendor-react.js",
        "vendor-helium.js",
        "vendor-charts.js",
        "vendors.js",
        "vendor-shared-src.js",
        "vendor-i18n.js",
        "amazon-script.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.walmart.com/*"
      ],
      "css": [],
      "js": [
        "domain-detector.js",
        "vendor-react.js",
        "vendor-helium.js",
        "vendor-charts.js",
        "vendors.js",
        "vendor-shared-src.js",
        "vendor-i18n.js",
        "walmart-script.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "*://shop.tiktok.com/us/*",
        "*://www.tiktok.com/shop/us/*",
        "*://shop.tiktok.com/*",
        "*://www.tiktok.com/shop/*"
      ],
      "exclude_matches": [
        "*://shop.tiktok.com/jp/*",
        "*://shop.tiktok.com/gb/*",
        "*://shop.tiktok.com/uk/*",
        "*://shop.tiktok.com/id/*",
        "*://shop.tiktok.com/th/*",
        "*://shop.tiktok.com/vn/*",
        "*://shop.tiktok.com/ph/*",
        "*://shop.tiktok.com/sg/*",
        "*://shop.tiktok.com/my/*",
        "*://shop.tiktok.com/mx/*",
        "*://shop.tiktok.com/br/*",
        "*://www.tiktok.com/shop/jp/*",
        "*://www.tiktok.com/shop/gb/*",
        "*://www.tiktok.com/shop/uk/*",
        "*://www.tiktok.com/shop/id/*",
        "*://www.tiktok.com/shop/th/*",
        "*://www.tiktok.com/shop/vn/*",
        "*://www.tiktok.com/shop/ph/*",
        "*://www.tiktok.com/shop/sg/*",
        "*://www.tiktok.com/shop/my/*",
        "*://www.tiktok.com/shop/mx/*",
        "*://www.tiktok.com/shop/br/*"
      ],
      "css": [],
      "js": [
        "domain-detector.js",
        "vendor-react.js",
        "vendor-helium.js",
        "vendor-charts.js",
        "vendors.js",
        "vendor-shared-src.js",
        "vendor-i18n.js",
        "tiktok-script.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "incognito": "split",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "permissions": [
    "background",
    "activeTab",
    "tabs",
    "storage",
    "unlimitedStorage",
    "browsingData",
    "cookies",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_permissions": [],
  "host_permissions": [
    "*://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "*://*.helium-dev.com/*",
      "*://*.helium10.com/*",
      "*://*.helium-staging.com/*",
      "*://*.amztoolsconsultant.com/*",
      "*://__H10_PROXY_HOST__/*"
    ]
  }
}
