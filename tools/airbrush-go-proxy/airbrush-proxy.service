[Unit]
Description=Airbrush Go Proxy (ToolsMandi)
After=network.target mysql.service

[Service]
Type=simple
User=root
WorkingDirectory=/www/wwwroot/1clkaccess.store/airbrush
ExecStart=/www/wwwroot/1clkaccess.store/airbrush/airbrush-proxy
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=airbrush-proxy
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
