[Unit]
Description=Claude AI Recloud Proxy (claude.ai)
After=network.target mysql.service

[Service]
Type=simple
User=root
WorkingDirectory=/www/wwwroot/1clkaccess.store/claude
ExecStart=/www/wwwroot/1clkaccess.store/claude/claude-ai-go-proxy
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=claude-recloud
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
