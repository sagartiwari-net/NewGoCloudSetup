[Unit]
Description=gt4rents panel-api (127.0.0.1:18090)
After=network-online.target mysql.service mysqld.service mariadb.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/www/wwwroot/gt4rents.com/panel
ExecStart=/www/wwwroot/gt4rents.com/_repo/deploy/run-panel-api.sh
Restart=always
RestartSec=3
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
