[Unit]
Description=gt4rents panel UI Next.js (port 3000)
After=network.target gt4-panel-api.service

[Service]
Type=simple
WorkingDirectory=/www/wwwroot/gt4rents.com/_repo/panel/update-panel
Environment=PORT=3000
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
