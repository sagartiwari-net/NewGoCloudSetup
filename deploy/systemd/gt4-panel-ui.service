[Unit]
Description=gt4rents panel UI Next.js (port 3000)
After=network-online.target gt4-panel-api.service
Wants=gt4-panel-api.service

[Service]
Type=simple
WorkingDirectory=/www/wwwroot/gt4rents.com/_repo/panel/update-panel
Environment=PORT=3000
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-http-header-size=524288
ExecStart=/www/wwwroot/gt4rents.com/_repo/deploy/run-panel-ui.sh
Restart=always
RestartSec=3
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
